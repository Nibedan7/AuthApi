@model List<AuthUi.Models.Employee>

@{
    ViewData["Title"] = "Employees List";
}

<h2>Employees List</h2>
<a href="@Url.Action("Add", "Emp")" class="btn btn-primary">Add New Employee</a>


@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Designation</th>
                <th>Department</th>
                <th>Joining Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Designation</td>
                    <td>@employee.Department</td>
                    <td>@employee.Joining_date.ToShortDateString()</td>
                    <td>
                        <a href="@Url.Action("Edit", "Emp", new { id = employee.Id })" class="btn btn-warning">Edit</a>
                        <a class ="btn btn-danger" href="@Url.Action("Delete", "Emp", new { id = employee.Id })" class="btn btn-warning">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No employees found.</p>
}

